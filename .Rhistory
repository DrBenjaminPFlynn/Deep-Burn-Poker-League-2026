# Library----
library(dplyr)
library(ggplot2)
library(ggrepel)
library(viridisLite)
library(plyr)
library(stringr)
# DIR & Variables----
DIR <- "C:/Users/mdzbf/OneDrive - University of Bristol/Desktop/WelshG_SankyoD/PatientSamples/MasterCopy"
df <- read.csv(file = paste0(DIR, "/FinalPatientDataFrame.csv"),
header = TRUE)
df <- df %>%
mutate(
Plasma.Grouping = case_when(
Source == "Plasma" ~ sub("_.*", "", Sample.No.),
TRUE               ~ Source # Keeps original source (e.g., PEx) if it's not Plasma
)
)
# ELISA Results From Plasma----
df %>%
filter(
(is.na(`SP.IPT..µM.`) | `SP.IPT..µM.` == 0 | `SP.IPT..µM.` == "") &
(is.na(`SP.SPINK.DS0041..µM.`) | `SP.SPINK.DS0041..µM.` == 0 | `SP.SPINK.DS0041..µM.` == "") & # Remove inhibitor treatments as this will cause replicate ID's
!is.na(MASP3.Estimated.Conc...ng.ml.) &   # Remove any results that have not been ELISA tested
Source == "Plasma" # Plasma sample results only
) %>%
ggplot(aes(x = Plasma.Grouping,
y = MASP3.Estimated.Conc...ng.ml.,
group = Plasma.Grouping,
color = Plasma.Grouping)) +
geom_boxplot(outlier.shape = NA, alpha = 0.5) +
geom_point(position = position_jitter(width = 0.25, height = 0, seed = 123),
size = 3) +
geom_text_repel(aes(label = ID), alpha = 0.5,
size = 3, max.overlaps = 100,  min.segment.length = 0,
segment.size = 0.4, box.padding = 0.4, show.legend = FALSE,
position = position_jitter(width = 0.25, height = 0, seed = 123)) +
theme_light() +
theme(plot.title = element_text(hjust = 0.5),
axis.text.x = element_text(angle = 0, hjust = 0.5, vjust = 1),
legend.position = "right",
axis.line = element_line(color = "black"), axis.ticks = element_line(color = "black"),
strip.background = element_blank()) +
labs(title = "ELISA MASP3 (ELK10166)",
x = "",
y = "MASP3 Estimated Conc. (ng/ml)",
color = "Disease Status")
# ELISA Results From Plasma Exchange----
df %>%
filter(
(is.na(`SP.IPT..µM.`) | `SP.IPT..µM.` == 0 | `SP.IPT..µM.` == "") &
(is.na(`SP.SPINK.DS0041..µM.`) | `SP.SPINK.DS0041..µM.` == 0 | `SP.SPINK.DS0041..µM.` == "") & # Remove inhibitor treatments as this will cause replicate ID's
!is.na(MASP3.Estimated.Conc...ng.ml.) &   # Remove any results that have not been ELISA tested
Source == "Plasma Exchange" # Plasma sample results only
) %>%
ggplot(aes(x = Sample.No.,
