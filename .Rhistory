DIR <- paste0("C:/Users/mdzbf/OneDrive - University of Bristol/Desktop",
"/WelshG_SankyoD")
ELISA <- c("004", "005", "006")
SPHEROIDS <- c("Z:/Spheroids/SP024-SP027/SP024_SP027_Results_UserDefined.csv",
"Z:/Spheroids/SP028-SP031/SP028_SP031_Results_UserDefined.csv",
"Z:/Spheroids/SP032-SP035/SP032_SP035_Results_UserDefined.csv",
"G:/Spheroids/SP040_SP043_Results_UserDefined.csv")
CH50 <- c("")
AP50 <- c("C:/Users/mdzbf/OneDrive - University of Bristol/Desktop/WelshG_SankyoD/HaemoAssay/HaemoAss003_AP",
"C:/Users/mdzbf/OneDrive - University of Bristol/Desktop/WelshG_SankyoD/HaemoAssay/HaemoAss004_AP")
# Patient Meta-Data----
## My up to date notes
df <- read.csv(paste0(DIR, "/PatientSamples/MasterCopy/PatientSamples.csv"),
header = TRUE)
## Legacy Jude Provided Information
df <- merge(df,
read.csv(paste0(DIR, "/PatientSamples/MasterCopy/Tobias_Nephros_PEx.csv")) %>%
select(-any_of(c("Sample.No.", "Location"))),
by = "ID", all.x = TRUE)
## DHB CON metadata
for (SAMPLE in c("C", "I", "J")) {
df[df[["ID"]] == paste0("P_DHBCon_", SAMPLE),][["Nephrin.IP"]] <- "V Low"
}
for (SAMPLE in c("C", "I", "J")) {
df[df[["ID"]] == paste0("P_DHBCon_", SAMPLE),][["Nephrin.IP"]] <- "< P_DHBCon_C"
}
## Add missing entries
df[df[["ID"]] == "PEx_3127-02", ][["Sample.Date"]] <- "06/08/2017"
df[df[["ID"]] == "PEx_3127-03", ][["Sample.Date"]] <- "10/08/2017"
## Standardise Primary Diagnosis
df <- df %>%
mutate(Primary.Diagnosis.Standardised = case_when(
# Steroid Resistant nephrtoic Syndrome - Primary Steroid Resistance
Primary.Diagnosis == "SRNS - PSR" ~ "SRNS-PSR",
Primary.Diagnosis == "SRNS - PRS" ~ "SRNS-PSR",
Primary.Diagnosis == "SRNS - Presumed SR" ~ "SRNS-PSR",
Primary.Diagnosis == "SRNS - PSR" ~ "SRNS-PSR",
Primary.Diagnosis == "SRNS - Primary Steroid Resistance" ~ "SRNS-PSR",
# Steroid Resistant nephrtoic Syndrome - Secondary Steroid Resistance
Primary.Diagnosis == "SSNS - SS" ~ "SRNS-SSR",
Primary.Diagnosis == "SRNS - SSR" ~ "SRNS-SSR",
Primary.Diagnosis == "SSNS - Secondary Steroid Resistance" ~ "SRNS-SSR",
Primary.Diagnosis ==  "SRNS - Secondary Steroid Resistance" ~ "SRNS-SSR",
.default = Primary.Diagnosis
))
# Nephrin Resutls----
## Check for samples not merged
df.inter <- read.csv(paste0(DIR, "/PatientSamples/MasterCopy/20260220_Results_Nephrin.csv"),
header = TRUE) %>%
anti_join(df, by = "ID")
cat("Samples from the Nephrin were not merged: ", c(df.inter[["ID"]]))
write.csv(file = paste0(DIR, "/PatientSamples/MasterCopy/NephrinResultsNotMerged.csv"),
df.inter, row.names = FALSE)
rm(df.inter)
## Merge results to master dataframe
df <- merge(df,
read.csv(paste0(DIR, "/PatientSamples/MasterCopy/20260220_Results_Nephrin.csv"),
header = TRUE) %>%
select(ID, "Result.Anti.Nephrin.IP") %>%
rename_with(~ "2026 Anti-Nephrin IP", .cols = "Result.Anti.Nephrin.IP"),
by = "ID", all.x = TRUE) %>%
mutate(Nephrin.Status.2026 = case_when(`2026 Anti-Nephrin IP` == 1 ~ "Positive",
`2026 Anti-Nephrin IP` == 0 ~ "Negative",
is.na(`2026 Anti-Nephrin IP`) ~ "Not Tested")
)
# ELISA MASP3----
## Master dataframe
df.ELISA <- df[, "ID", drop = FALSE]
## ggplot ready dataframe
COLNAMES.GGPLOT <- c("ID", "Average OD", "Estimated Conc.", "ELISA No.")
df.ELISA.ggplot <- data.frame(matrix(ncol = length(COLNAMES.GGPLOT),
nrow = 0))
for (ELISA.NO in ELISA) {
df.inter <- read.csv(file = paste0(DIR, "/ELISA/ELISAMASP3", ELISA.NO, "/RAnalysedResults.csv"),
header = TRUE) %>%
select(ID, Average_OD, Est.Conc) %>%
filter(!ID == "") %>% # Remove any empty rows
mutate("ELISA No." = paste(ELISA.NO))
# Add to ggplot ready dataframe
df.ELISA.ggplot <- rbind(df.ELISA.ggplot, df.inter)
# Format for master dataframe
df.inter <- df.inter %>%
select(!"ELISA No.") %>%
rename_with(~ paste0("ELISA MASP3 ", ELISA.NO, " Average OD (450nm)"), .cols = Average_OD) %>%
rename_with(~ paste0("ELISA MASP3 ", ELISA.NO, " Estimated Conc. (ng/ml)"), .cols = Est.Conc)
# Merge back into master df.ELISA
df.ELISA <- merge(df.ELISA, df.inter, by = "ID", all.x = TRUE)
rm(df.inter)
}
## Add Final MASP3 results to master dataframe, based on the latest ELISA run
od_cols <- names(df.ELISA) %>%
grep("^ELISA MASP3 \\d+ Average OD", ., value = TRUE) %>% # Select Average OD columns
sort(decreasing = TRUE) # Sort highest ELISA number first
conc_cols <- names(df.ELISA) %>%
grep("^ELISA MASP3 \\d+ Estimated Conc", ., value = TRUE) %>% # Select Estimated Conc. columns
sort(decreasing = TRUE) # Sort highest ELISA number first
df.ELISA <- df.ELISA %>%
mutate(`MASP3 Average OD (450nm)` = coalesce(!!!syms(od_cols)),
`MASP3 Estimated Conc. (ng/ml)` = coalesce(!!!syms(conc_cols))) # Create final columns
## Save data frames to ELISA folder
write.csv(file = paste0(DIR, "/ELISA/ELISA_Results_Master.csv"),
filter(df.ELISA, if_any(all_of(c(od_cols, conc_cols)), ~ !is.na(.))),
row.names = FALSE)
write.csv(file = paste0(DIR, "/ELISA/ELISA_Results_ggplotReady.csv"),
df.ELISA.ggplot, row.names = FALSE)
## Master dataframe
df <- merge(df, df.ELISA,
by = "ID", all.x = TRUE)
